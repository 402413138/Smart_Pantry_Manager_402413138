
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:paddingTop="15dp"
        android:paddingBottom="16dp"/>

    <Switch
        android:id="@+id/switchExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiration reminder"
        android:textSize="21sp"
        android:layout_marginBottom="15dp"/>

    <Switch
        android:id="@+id/switchDarkMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dark mode"
        android:textSize="21sp"
        android:layout_marginBottom="15dp"/>

    <Switch
        android:id="@+id/switchUnitSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unit system: South African (Metric)"
        android:textSize="21sp"
        android:layout_marginBottom="15dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantities are compared in the same unit. Convert units to a common unit before entering them for reliable matching."
        android:paddingTop="20dp"/>

</LinearLayout>
